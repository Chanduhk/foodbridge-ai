# FoodBridge AI Environment Configuration

PROJECT_NAME="FoodBridge AI"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api"

# Security & JWT
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL default, or sqlite+aiosqlite:///./test.db for local test)
DATABASE_URL="postgresql+psycopg://foodbridge_user:foodbridge_secret_pw@localhost:5432/foodbridge_db"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
